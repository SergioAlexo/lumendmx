{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and popped-out tabs",
  "windows": [
    "main",
    "view-*"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "opener:default",
    "process:default",
    "updater:default"
  ]
}
