{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumenDMX",
  "version": "0.1.0",
  "identifier": "com.pashchenkos.lumendmx",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LumenDMX",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "backgroundColor": "#0c0c0e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCNTZFOTdEN0YzMDRGRTEKUldUaFR6Qi9mZWxXaTJ6VmltbnhtZXdIdlFTMmdUVjRQaWJhZ080V3J0bGsyblIyMDVJd0FXT0cK",
      "endpoints": [
        "https://github.com/sergioalexo/lumendmx/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
